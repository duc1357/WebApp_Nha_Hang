# ============================================================
# .htaccess - Cấu hình bảo mật cho Nhà Hàng Cơm Quê Dượng Bầu
# ============================================================

# Bật RewriteEngine (cần mod_rewrite trên Apache/Laragon)
Options -Indexes
RewriteEngine On

# ============================================================
# BLOCK TRUY CẬP TRỰC TIẾP CÁC THƯ MỤC NHẠY CẢM
# ============================================================

# Chặn truy cập vào /config/ từ web
RewriteRule ^config(/|$) - [F,L]

# Chặn truy cập vào /Database/ từ web
RewriteRule ^Database(/|$) - [F,L]

# Chặn truy cập vào /lib/ từ web
RewriteRule ^lib(/|$) - [F,L]

# Chặn truy cập vào /logs/ từ web
RewriteRule ^logs(/|$) - [F,L]

# ============================================================
# BLOCK FILE NHẠY CẢM
# ============================================================

# Chặn file .env (environment variables)
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# Chặn file .env.example từ web (chỉ cần cho dev reference)
<FilesMatch "^\.env\.example$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Chặn tất cả file .log
<FilesMatch "\.log$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Chặn file SQL dump
<FilesMatch "\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Chặn file .gitignore và git files
<FilesMatch "^\.git">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================================
# SECURITY HEADERS
# ============================================================

<IfModule mod_headers.c>
    # Ngăn MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Ngăn clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Bật XSS filter của trình duyệt cũ
    Header always set X-XSS-Protection "1; mode=block"

    # Không gửi Referer khi navigate ra ngoài
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # [2.6] Content Security Policy
    # Cho phép: CDN cần thiết (Chart.js, Font Awesome, Google Fonts)
    # Chặn: inline scripts lạ, object/embed, framing từ domain khác
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://qr.sepay.vn; frame-ancestors 'none'; object-src 'none';"

    # [2.6] Permissions Policy – tắt các API trình duyệt không cần thiết
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self)"

    # [2.6] HSTS – Bắt buộc HTTPS (chỉ bật khi production có SSL)
    # Bỏ comment dòng dưới khi đã có HTTPS/SSL certificate
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Xóa thông tin server version
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ============================================================
# PHP SECURITY SETTINGS
# ============================================================

<IfModule mod_php.c>
    # Tắt hiển thị lỗi PHP ra browser (chỉ log)
    php_flag display_errors Off
    php_flag log_errors On

    # [2.6] Giới hạn upload size (2MB nhất quán với code PHP)
    php_value upload_max_filesize 2M
    php_value post_max_size 4M

    # [2.6] Session security
    php_flag session.cookie_httponly On
    php_flag session.cookie_samesite Lax
    php_value session.cookie_path /
</IfModule>

# ============================================================
# CACHE CONTROL cho assets tĩnh
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType text/css   "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
