# ==============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên Git!
# ==============================================

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=duong_bau_restaurant

# --- Application ---
BASE_URL=http://restaurant.test

# --- Runtime ---
# local, staging, or production
APP_ENV=local

# --- Mail (Gmail SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_PORT=465
MAIL_FROM_NAME=Nha Hang Duong Bau

# --- SePay Webhook ---
# Lấy API Key trong dashboard SePay
SEPAY_WEBHOOK_TOKEN=YOUR_SEPAY_API_TOKEN_HERE

# --- Payment ---
# Used for QR generation and webhook account validation.
SEPAY_VA_ACCOUNT=YOUR_VIRTUAL_ACCOUNT_ID
SEPAY_BANK_NAME=MBBank

# --- JWT (JSON Web Token) ---
# Tạo bằng lệnh: php -r "echo bin2hex(random_bytes(32));"
# QUAN TRỌNG: Đặt chuỗi random ít nhất 32 ký tự, KHÔNG chia sẻ!
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
# Thời gian token hết hạn (giây): 604800 = 7 ngày
JWT_TTL_SECONDS=604800

# --- Redis Cache & Rate Limiting ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0
REDIS_ENABLED=true
