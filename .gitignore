# config/mail_config.php

# Log files
*.log
logs/
api/payment/*.log

# Upload files (nên dùng cloud storage trong production)
photo/avatars/
photo/menu/

# IDE & OS files
.idea/
.vscode/
*.DS_Store
Thumbs.db

# Local isolated worktrees
.worktrees/
